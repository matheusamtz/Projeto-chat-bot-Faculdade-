# =============== CHAT (LLM que gera as respostas) ===============
# Cole sua chave aqui. Aceita OpenAI direta, OpenRouter, Together, Groq, etc.
OPENAI_API_KEY=sk-...

# OpenAI direta (padrão):
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini

# OpenRouter (suporta dezenas de modelos, alguns gratuitos):
OPENAI_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-4o-mini
# Alternativas no OpenRouter:
#   meta-llama/llama-3.3-70b-instruct:free   (gratuito, com limite de rate)
#   google/gemini-flash-1.5                   (rápido e barato)
#   anthropic/claude-haiku-4.5                (excelente em PT-BR)


# =============== EMBEDDINGS (vetorização da base) ===============
# "local"  = usa sentence-transformers no seu PC (sem custo, sem API). PADRÃO.
# "openai" = usa OpenAI text-embedding-3-small (precisa OPENAI_EMBEDDING_API_KEY abaixo).
EMBEDDING_BACKEND=local

# Se EMBEDDING_BACKEND=local, você pode trocar o modelo aqui:
#   paraphrase-multilingual-MiniLM-L12-v2   (118MB, dim=384, ótimo PT-BR — padrão)
#   intfloat/multilingual-e5-small          (118MB, dim=384)
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Se EMBEDDING_BACKEND=openai, configure os campos abaixo:
# OPENAI_EMBEDDING_API_KEY=sk-...
# OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# =============== SERVIDOR ===============
FLASK_PORT=5000


# =============== DEPLOY NA VERCEL ===============
# Em producao, sentence-transformers (>250MB) nao cabe em uma Vercel Function.
# Configure obrigatoriamente EMBEDDING_BACKEND=openai e as 3 variaveis abaixo:
#   EMBEDDING_BACKEND=openai
#   OPENAI_EMBEDDING_API_KEY=sk-...
#   OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
#   OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# E rode `python ingest.py` localmente com essa config ANTES de fazer deploy
# (a dim do embedding precisa bater com o modelo usado em runtime).
